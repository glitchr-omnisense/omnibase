{
    "name": "glitchr/base-bundle",
    "type": "symfony-bundle",
    "description": "Base helper integration for Symfony",
    "keywords": ["symfony", "base", "helper"],
    "homepage": "https://gitlab.glitchr.dev/public-repository/symfony",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "autoload": {
        "psr-4": {
            "Base\\": "./src"
        },
        "files": [
            "src/Resources/Functions.php"
        ]
    },

    "autoload-dev": {
        "psr-4": {
            "Tests\\Base\\": "./tests"
        }
    },
    "repositories": [
        { "type": "vcs", "url": "https://gitlab.glitchr.dev/public-repository/agnostic/backup-manager" },
        { "type": "vcs", "url": "https://gitlab.glitchr.dev/public-repository/symfony/bundle/base/plugin" },
        { "type": "vcs", "url": "https://gitlab.glitchr.dev/public-repository/symfony/bundle/doctrine-dc2type" },
        { "type": "vcs", "url": "https://gitlab.glitchr.dev/public-repository/symfony/bundle/hypertext-bundle" },
        { "type": "vcs", "url": "https://gitlab.glitchr.dev/public-repository/symfony/bundle/well-known" }
    ],
    "require": {
        "php": "^8.1",
        "beberlei/doctrineextensions": "^1.0",
        "doctrine/annotations": "^2.0",
        "doctrine/doctrine-bundle": "^2.0|^3.0",
        "easycorp/easyadmin-bundle": "^4.0|^5.0",
        "api-platform/api-pack": "^1.0",
        "endroid/qr-code": "^4.0",
        "enshrined/svg-sanitize": "^0.22",
        "florianv/swap": "^4.0",
        "glitchr/backup-manager": "4.0.*-dev",
        "glitchr/well-known": "1.0.*-dev",
        "glitchr/base-plugin": "2.0.*-dev",
        "glitchr/doctrine-dc2type": "1.0.*-dev",
        "hashids/hashids": "^4.1",
        "imagine/imagine": "^1.2",
        "league/flysystem-bundle": "^3.1",
        "league/flysystem-ftp": "^3.0",
        "nelmio/cors-bundle": "^2.2",
        "nelmio/security-bundle": "^3.0",
        "phpoffice/phpspreadsheet": "^1.23|^2.0",
        "picqer/php-barcode-generator": "^2.0",
        "scheb/2fa": "^7.0|^8.0",
        "scienta/doctrine-json-functions": "~4.3",
        "symfony/config": "^6.0|^7.0|^8.0",
        "symfony/dependency-injection": "^6.0|^7.0|^8.0",
        "symfony/discord-notifier": "^6.0|^7.0|^8.0",
        "symfony/dotenv": "^6.0|^7.0|^8.0",
        "symfony/form": "^6.0|^7.0|^8.0",
        "symfony/framework-bundle": "^6.0|^7.0|^8.0",
        "symfony/http-client": "^6.0|^7.0|^8.0",
        "symfony/intl": "^6.0|^7.0|^8.0",
        "symfony/mailer": "^6.0|^7.0|^8.0",
        "symfony/messenger": "^6.0|^7.0|^8.0",
        "symfony/notifier": "^6.0|^7.0|^8.0",
        "symfony/security-bundle": "^6.0|^7.0|^8.0",
        "symfony/serializer": "^6.0|^7.0|^8.0",
        "symfony/twig-bundle": "^6.0|^7.0|^8.0",
        "symfony/ux-twig-component": "^2.0|^3.0",
        "symfony/uid": "^6.0|^7.0|^8.0",
        "symfony/validator": "^6.0|^7.0|^8.0",
        "symfony/workflow": "^6.0|^7.0|^8.0",
        "twig/cache-extra": "^3.0",
        "twig/cssinliner-extra": "^3.0",
        "twig/extra-bundle": "^3.0",
        "twig/inky-extra": "^3.0",
        "twig/intl-extra": "^3.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^10.5",
        "wapmorgan/php-deprecation-detector": "^2.0",
        "doctrine/doctrine-fixtures-bundle": "^3.4",
        "squizlabs/php_codesniffer": "^3.7",
        "doctrine/doctrine-migrations-bundle": "^3.0",
        "symfony/debug-bundle": "^6.0|^7.0|^8.0",
        "symfony/phpunit-bridge": "^6.0|^7.0|^8.0",
        "symfony/stopwatch": "^6.0|^7.0|^8.0",
        "symfony/var-dumper": "^6.0|^7.0|^8.0",
        "symfony/web-profiler-bundle": "^6.0|^7.0|^8.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
