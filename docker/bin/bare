#!/usr/bin/env php
<?php

/*
 * The core in bare PHP: no kernel, no container, no bundle booted. Only the
 * Composer autoloader is required, then each class asked is loaded in turn,
 * and every class, interface, trait and file PHP loaded on the way is checked
 * against the framework (see FRAMEWORK below). tests/BareTest.php runs it in
 * a PHP process of its own over tests/Fondation.php.
 *
 *   docker compose run --rm omnibase bare                       # the Fondation (tests/Fondation.php); exits 1 when a class of the framework was loaded
 *   docker compose run --rm omnibase bare 'Base\BaseBundle'     # the classes named
 *   docker compose run --rm omnibase bare --all --each          # every class of src/, each in a PHP process of its own
 *   docker compose run --rm omnibase bare --json                # the same, whole, as JSON
 *   docker compose run --rm omnibase bare --names               # informative: the classes of the Fondation that name the framework
 *   docker compose run --rm omnibase bare path/to/script.php    # a script run with the autoloader alone (what it returns is in --json)
 *
 * --each loads every class in a fresh process (exact for each class, slower);
 * without it the classes are loaded one after the other in this process, and
 * a framework class is reported under the first class that brought it.
 *
 * --names is a second report, informative, not a guard (plan "omnibase
 * agnostique", §6, the decision on C1): nothing is loaded, each file is read.
 * A class "names" the framework when its file imports a class, function or
 * constant of the framework (its `use` lines) or writes one fully qualified
 * in its code (`\Symfony\Component\...\Request::class`), even where loading
 * the class loads none of it (a type in a signature, a `new` in a method).
 * Two counts: the classes that name it themselves, and those that name it
 * themselves or through the Base\ classes they name, followed to the end.
 * It is the dashboard of the seams (C3-C5): the Fondation only grows, this
 * report only falls.
 *
 * The framework (plan "omnibase agnostique", §0 and D1-D4): symfony/framework-
 * bundle and every *-bundle (DoctrineBundle, TwigBundle, SecurityBundle,
 * WebpackEncoreBundle, the third-party ones), symfony/*-bridge,
 * dependency-injection, config, http-kernel, http-foundation, routing,
 * security-*, form, console, symfony/ux-*, API Platform, HWI, Scheb,
 * Webauthn's bundle, Nelmio. Not the framework: PHP, the standalone Symfony
 * components (string, uid, intl, translation, validator, serializer, mime,
 * mailer, notifier, cache, workflow, event-dispatcher, options-resolver,
 * property-access, http-client, the contracts...), Doctrine (storage: ORM,
 * DBAL, collections, persistence) and Twig (the view).
 */

// A notice or a deprecation goes to the error output, not into the report.
ini_set('display_errors', 'stderr');

// A namespace segment ending in Bundle is a bundle's - except symfony/intl's resource readers
// (Symfony\Component\Intl\Data\Bundle\...), a standalone component's (plan, C3e).
const FRAMEWORK = '~^(?:Symfony\\\\Component\\\\(?:DependencyInjection|Config|HttpKernel|HttpFoundation|Routing|Security|Form|Console)\\\\|Symfony\\\\(?:Bundle|Bridge|UX)\\\\|ApiPlatform\\\\|HWI\\\\|Scheb\\\\|Nelmio\\\\|(?!Base\\\\|Symfony\\\\Component\\\\Intl\\\\)(?:[A-Za-z0-9_]+\\\\)*[A-Za-z0-9_]*Bundle\\\\)~';
const FRAMEWORK_FILES = '~/vendor/(?:symfony/(?:dependency-injection|config|http-kernel|http-foundation|routing|security-[a-z-]+|form|console|ux-[a-z-]+|[a-z-]+-bundle|[a-z-]+-bridge)|[a-z0-9_.-]+/[a-z0-9_.-]*-bundle|api-platform/[a-z0-9_.-]+|hwi/[a-z0-9_.-]+|scheb/[a-z0-9_.-]+|nelmio/[a-z0-9_.-]+)/~';

$options = ['json' => false, 'all' => false, 'each' => false, 'names' => false];
$classes = [];
foreach (array_slice($argv, 1) as $argument) {
    if (in_array($argument, ['-h', '--help'], true)) {
        echo "bare [--all] [--each] [--json] [class...]: the classes named, every class of src/ (--all) or the Fondation (tests/Fondation.php), loaded with Composer's autoloader alone.\n";
        echo "bare --names [--all] [--json] [class...]: informative, not a guard: which of those classes name the framework in their use lines or code, themselves or through the Base\\ classes they name.\n";
        exit(0);
    }
    if (str_starts_with($argument, '--') && isset($options[substr($argument, 2)])) {
        $options[substr($argument, 2)] = true;
    } else {
        $classes[] = ltrim($argument, '\\');
    }
}

$core = dirname(__DIR__, 2);
$autoload = getenv('OMNIBASE_AUTOLOAD') ?: null;
foreach ([$core.'/vendor/autoload.php', $core.'/../../autoload.php'] as $candidate) {
    $autoload ??= is_file($candidate) ? realpath($candidate) : null;
}
if (null === $autoload) {
    fwrite(STDERR, "No Composer autoloader found (vendor/autoload.php, or the host application's): run \"composer install\", or set OMNIBASE_AUTOLOAD.\n");
    exit(2);
}

if ($options['all']) {
    $files = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($core.'/src', FilesystemIterator::SKIP_DOTS));
    foreach ($files as $file) {
        $path = substr($file->getPathname(), strlen($core.'/src/'));
        if (str_ends_with($path, '.php') && !str_starts_with($path, 'Resources/')) {
            $classes[] = 'Base\\'.str_replace('/', '\\', substr($path, 0, -4));
        }
    }
} elseif (!$classes) {
    $classes = require $core.'/tests/Fondation.php';
}
$classes = array_values(array_unique($classes));
sort($classes);

if ($options['names']) {
    exit(names_report($classes, $core, $options['json']));
}

$report = $options['each'] ? each_apart($classes, $autoload) : load_here($classes, $autoload);
$report['autoload'] = $autoload;

$failed = array_filter($report['classes'], static fn (array $class) => $class['framework'] || $class['framework_files'] || null !== $class['error']);
if ($options['json']) {
    echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n";
    exit($failed || $report['baseline']['symbols'] ? 1 : 0);
}

printf("The core in bare PHP: %d classes loaded with %s alone, no kernel, no container.\n\n", count($classes), $autoload);
foreach ([...$report['baseline']['symbols'], ...$report['baseline']['files']] as $loaded) {
    printf("  the autoloader itself, before any class: %s\n", $loaded);
}
foreach ($failed as $class => $result) {
    printf("✗ %s\n", $class);
    if (null !== $result['error']) {
        printf("    does not load: %s\n", $result['error']);
    }
    foreach ($result['framework'] as $symbol => $askedBy) {
        printf("    %s%s\n", $symbol, null === $askedBy || $askedBy === $class ? '' : ', asked by '.$askedBy);
    }
    foreach ($result['framework_files'] as $file) {
        printf("    %s\n", $file);
    }
}
printf("\n%d without the framework, %d with it or not loaded.\n", count($classes) - count($failed), count($failed));
exit($failed || $report['baseline']['symbols'] ? 1 : 0);

/**
 * Loads the classes one after the other in this process.
 *
 * @param list<string> $classes
 *
 * @return array{baseline: array{symbols: list<string>, files: list<string>}, classes: array<string, array{error: ?string, framework: array<string, ?string>, framework_files: list<string>, boundary: array<string, string>}>}
 */
function load_here(array $classes, string $autoload): array
{
    $loader = require $autoload;
    // What the autoloader loads by itself, before any class is asked: Composer's
    // "files" entries (api-platform/jsonld's HydraContext.php, a constant, while
    // the core requires API Platform). Reported, not held against a class.
    $baseline = ['symbols' => array_values(preg_grep(FRAMEWORK, symbols_since([0, 0, 0]))), 'files' => array_values(preg_grep(FRAMEWORK_FILES, get_included_files()))];

    // Who asked for each class: the class being loaded when PHP asked for it
    // (its parent, an interface, a trait, a class its file uses at once).
    $asked = [];
    $stack = [];
    spl_autoload_register(static function (string $class) use ($loader, &$asked, &$stack): void {
        $asked[$class] ??= $stack ? end($stack) : null;
        $stack[] = $class;
        try {
            $loader->loadClass($class);
        } finally {
            array_pop($stack);
        }
    }, true, true);

    $report = [];
    foreach ($classes as $class) {
        [$symbols, $files] = [counts(), count(get_included_files())];
        $error = null;
        $result = null;
        try {
            if (str_ends_with($class, '.php') && is_file($class)) {
                // A script, not a class: run with the autoloader alone, what it returns reported.
                $result = (static fn (string $script) => require $script)($class);
            } elseif (!class_exists($class) && !interface_exists($class) && !trait_exists($class)) {
                $error = 'no class, interface, trait nor enum of that name';
            }
        } catch (Throwable $e) {
            $error = $e::class.': '.$e->getMessage();
        }
        $framework = [];
        $boundary = [];
        foreach (preg_grep(FRAMEWORK, symbols_since($symbols)) as $symbol) {
            $framework[$symbol] = $asked[$symbol] ?? null;
            // The edge where the framework begins: the first class outside it on the way up.
            for ($by = $asked[$symbol] ?? null, $from = $symbol; null !== $by && preg_match(FRAMEWORK, $by); $from = $by, $by = $asked[$by] ?? null);
            if (null !== $by) {
                $boundary[$from] = $by;
            }
        }
        ksort($framework);
        ksort($boundary);
        $report[$class] = ['error' => $error, 'framework' => $framework, 'framework_files' => array_values(preg_grep(FRAMEWORK_FILES, array_slice(get_included_files(), $files))), 'boundary' => $boundary] + (null === $result ? [] : ['result' => $result]);
    }

    return ['baseline' => $baseline, 'classes' => $report];
}

/**
 * Loads each class in a PHP process of its own, a few at a time.
 *
 * @param list<string> $classes
 *
 * @return array{baseline: array{symbols: list<string>, files: list<string>}, classes: array<string, array<string, mixed>>}
 */
function each_apart(array $classes, string $autoload): array
{
    $report = ['baseline' => ['symbols' => [], 'files' => []], 'classes' => []];
    $running = [];
    $queue = $classes;
    $parallel = max(1, (int) (getenv('BARE_PARALLEL') ?: trim((string) @shell_exec('nproc 2>/dev/null')) ?: 4));
    while ($queue || $running) {
        while ($queue && count($running) < $parallel) {
            $class = array_shift($queue);
            // Files, not pipes: a report bigger than a pipe's buffer would block the process.
            $outputs = [tempnam(sys_get_temp_dir(), 'bare'), tempnam(sys_get_temp_dir(), 'bare')];
            $process = proc_open([PHP_BINARY, __FILE__, '--json', $class], [1 => ['file', $outputs[0], 'w'], 2 => ['file', $outputs[1], 'w']], $pipes, null, ['OMNIBASE_AUTOLOAD' => $autoload] + getenv());
            $running[$class] = [$process, $outputs];
        }
        foreach ($running as $class => [$process, $outputs]) {
            $status = proc_get_status($process);
            if ($status['running']) {
                continue;
            }
            proc_close($process);
            $status = $status['exitcode'];
            [$out, $err] = [(string) file_get_contents($outputs[0]), (string) file_get_contents($outputs[1])];
            array_map('unlink', $outputs);
            unset($running[$class]);
            $result = json_decode($out, true);
            if (!is_array($result) || !isset($result['classes'][$class])) {
                $report['classes'][$class] = ['error' => 'PHP exited '.$status.': '.trim(strtok($err.$out, "\n") ?: ''), 'framework' => [], 'framework_files' => [], 'boundary' => []];
                continue;
            }
            $report['baseline'] = $result['baseline'];
            $report['classes'][$class] = $result['classes'][$class];
        }
        usleep(5000);
    }
    ksort($report['classes']);

    return $report;
}

/**
 * The informative report: which classes name the framework, themselves or
 * through the Base\ classes they name. Exits 0: it informs, it does not guard.
 *
 * @param list<string> $classes
 */
function names_report(array $classes, string $core, bool $json): int
{
    // Every class of src/, read once: a chain of Base\ names may leave the classes asked.
    $named = [];
    $files = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($core.'/src', FilesystemIterator::SKIP_DOTS));
    foreach ($files as $file) {
        $path = substr($file->getPathname(), strlen($core.'/src/'));
        if (str_ends_with($path, '.php') && !str_starts_with($path, 'Resources/')) {
            $named['Base\\'.str_replace('/', '\\', substr($path, 0, -4))] = names_in((string) file_get_contents($file->getPathname()));
        }
    }

    // Who names the framework itself, then who reaches it through a Base\ name, until nothing changes.
    $direct = [];
    foreach ($named as $class => $names) {
        $framework = array_values(preg_grep(FRAMEWORK, $names));
        if ($framework) {
            $direct[$class] = $framework;
        }
    }
    $through = [];
    do {
        $changed = false;
        foreach ($named as $class => $names) {
            if (isset($direct[$class]) || isset($through[$class])) {
                continue;
            }
            foreach ($names as $name) {
                if (isset($named[$name]) && (isset($direct[$name]) || isset($through[$name]))) {
                    $through[$class] = $name;
                    $changed = true;
                    break;
                }
            }
        }
    } while ($changed);

    $report = ['classes' => count($classes), 'direct' => [], 'through' => [], 'missing' => []];
    foreach ($classes as $class) {
        if (!isset($named[$class])) {
            $report['missing'][] = $class;
        } elseif (isset($direct[$class])) {
            $report['direct'][$class] = $direct[$class];
        } elseif (isset($through[$class])) {
            // The chain down to a class that names the framework itself.
            for ($chain = [$through[$class]]; isset($through[end($chain)]) && count($chain) < 50; $chain[] = $through[end($chain)]);
            $report['through'][$class] = ['chain' => $chain, 'framework' => $direct[end($chain)] ?? []];
        }
    }

    if ($json) {
        echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n";

        return 0;
    }
    printf("The names of the framework in %d classes (informative, not a guard): their use lines and fully qualified names, nothing loaded.\n\n", count($classes));
    foreach ($report['direct'] as $class => $names) {
        printf("● %s\n    %s\n", $class, implode("\n    ", $names));
    }
    foreach ($report['through'] as $class => ['chain' => $chain, 'framework' => $names]) {
        printf("○ %s\n    through %s: %s\n", $class, implode(' > ', $chain), implode(', ', $names));
    }
    foreach ($report['missing'] as $class) {
        printf("? %s: no file under src/\n", $class);
    }
    $direct = count($report['direct']);
    printf("\n%d name the framework themselves (●), %d more through the Base\\ classes they name (○): %d of %d; %d name none of it.\n", $direct, count($report['through']), $direct + count($report['through']), count($classes), count($classes) - $direct - count($report['through']) - count($report['missing']));

    return 0;
}

/**
 * The names a PHP file writes: its imports (`use` at the top, grouped ones
 * expanded, `use function` and `use const` too) and every fully qualified
 * name in its code. A trait's `use` inside a class and a closure's `use` are
 * not imports.
 *
 * @return list<string>
 */
function names_in(string $code): array
{
    $names = [];
    $tokens = token_get_all($code);
    $depth = 0;
    for ($i = 0, $n = count($tokens); $i < $n; ++$i) {
        $token = $tokens[$i];
        if (!is_array($token)) {
            $depth += '{' === $token ? 1 : ('}' === $token ? -1 : 0);
            continue;
        }
        if (in_array($token[0], [T_CURLY_OPEN, T_DOLLAR_OPEN_CURLY_BRACES], true)) {
            ++$depth;
        } elseif (T_NAME_FULLY_QUALIFIED === $token[0]) {
            $names[] = ltrim($token[1], '\\');
        } elseif (T_USE === $token[0] && 0 === $depth) {
            // One import statement, up to its semicolon, as words: "A\B as C , D\ { E , F\G }".
            $words = [];
            for (++$i; $i < $n && ';' !== $tokens[$i]; ++$i) {
                $part = $tokens[$i];
                if (!is_array($part)) {
                    $words[] = $part;
                } elseif (!in_array($part[0], [T_WHITESPACE, T_COMMENT, T_DOC_COMMENT], true)) {
                    $words[] = T_AS === $part[0] ? 'as' : $part[1];
                }
            }
            if (in_array(strtolower($words[0] ?? ''), ['function', 'const'], true)) {
                array_shift($words);
            }
            $prefix = '';
            $open = array_search('{', $words, true);
            if (false !== $open) {
                $prefix = rtrim(implode('', array_slice($words, 0, $open)), '\\').'\\';
                $words = array_slice($words, $open + 1);
            }
            $alias = false;
            foreach ($words as $word) {
                if ('as' === strtolower($word)) {
                    $alias = true;
                } elseif (',' === $word || '}' === $word) {
                    $alias = false;
                } elseif (!$alias && !in_array(strtolower($word), ['function', 'const'], true)) {
                    // A name inside a group may itself be qualified: "Prefix\{Sub\Name}".
                    $names[] = $prefix.ltrim($word, '\\');
                }
            }
        }
    }

    return array_values(array_unique(array_filter($names, static fn (string $name) => '' !== $name && !str_ends_with($name, '\\') && !in_array(strtolower($name), ['function', 'const'], true))));
}

/** @return array{int, int, int} how many classes (enums among them), interfaces and traits are declared */
function counts(): array
{
    return [count(get_declared_classes()), count(get_declared_interfaces()), count(get_declared_traits())];
}

/**
 * @param array{int, int, int} $counts
 *
 * @return list<string> the classes, interfaces and traits declared since those counts
 */
function symbols_since(array $counts): array
{
    return [...array_slice(get_declared_classes(), $counts[0]), ...array_slice(get_declared_interfaces(), $counts[1]), ...array_slice(get_declared_traits(), $counts[2])];
}
