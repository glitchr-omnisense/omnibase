<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>glitchr/base-bundle — demo</title>
    <style>
        body { font-family: monospace; max-width: 60em; margin: 2em auto; padding: 0 1em; }
        h1 { border-bottom: 3px double; padding-bottom: .3em; }
        section { border: 1px solid; margin: 1.5em 0; padding: 0 1em 1em; }
        pre { background: #eee; padding: .8em; overflow-x: auto; white-space: pre-wrap; }
        .ok::before { content: "[OK] "; }
        .error::before { content: "[FAILED] "; }
        p.about { font-style: italic; }
    </style>
</head>
<body>
    <h1>glitchr/base-bundle</h1>
    <p>A bare Symfony skeleton + this bundle, nothing else: no theme, no app code
       beyond this page. Each block below exercises one bundle feature.</p>

    {% for section in sections %}
    <section>
        <h2 class="{{ section.ok ? 'ok' : 'error' }}">{{ section.title }}</h2>
        <p class="about">{{ section.about }}</p>
        <pre>{{ section.output }}</pre>
    </section>
    {% endfor %}
</body>
</html>
