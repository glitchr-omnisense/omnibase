From 12da7ea7f56ddde821e34e4ca5e81a02f69e5736 Mon Sep 17 00:00:00 2001
From: Marco Meyer-Conde <marco.meyerconde.eic@gmail.com>
Date: Sat, 22 Aug 2026 05:21:28 +0200
Subject: [PATCH] Fix block duplication: await initial sync before deciding
 push vs apply

EditorYjs.attach() handed over to ContentBinding.attach() without waiting
for the WebsocketProvider's initial sync. ContentBinding decides "does this
room already have content?" from this.yarray.length, which is necessarily
still 0 while that sync is in flight, so every client took the "empty room"
branch and pushed its own full copy of the document.

Y.Array entries are identified by (client, clock) rather than by block id, so
those pushes appended genuine new entries instead of matching the existing
ones. The room grew by one full copy on every page load (observed live:
235 -> 267 -> 275 blocks over three loads), and a host app persisting the room
writes that growth straight into its database.

Fixed by awaiting _connectReady plus a new _whenSynced(), which resolves on the
provider's 'sync' event and times out after 5s so an unreachable relay still
degrades to offline editing rather than blocking the editor.

Also hardens the reconciliation that the duplicates were tripping over:

- applyRemoteToEditor() took a single editor.save() snapshot up front and then
  mutated the editor throughout the loop, so every iteration after the first
  computed positions from a stale picture. That produced EditorJS's "indices
  cannot be lower than 0 or greater than the amount of blocks" warning and
  could re-insert an already-present block. Positions are now re-read live per
  iteration via a new _editorBlockIds(), and insert/move indices are clamped.
  _editorBlockIds() walks the block list rather than calling getBlockIndex(id),
  which returns undefined (not -1) for an unknown id and logs its own warning
  as a side effect.

- syncLocalToYArray() now deduplicates by id before touching the CRDT. With
  duplicate ids, _findYIndexById() resolved both copies to the same first
  match, so the second deleted that entry and inserted past the now-shorter
  array - Yjs's "Length exceeded!". Inserts additionally go through a clamping
  _insertAt(), and _findYIndexById() tolerates empty entries.
---
 src/ContentBinding.js | 101 +++++++++++++++++++++++++++++++++++-------
 src/index.js          |  50 +++++++++++++++++++++
 2 files changed, 136 insertions(+), 15 deletions(-)

diff --git a/node_modules/editorjs-yjs/src/ContentBinding.js b/node_modules/editorjs-yjs/src/ContentBinding.js
index 69d03a8..611f8ec 100644
--- a/node_modules/editorjs-yjs/src/ContentBinding.js
+++ b/node_modules/editorjs-yjs/src/ContentBinding.js
@@ -160,8 +160,22 @@ export default class ContentBinding {
         // A remote operation can start during the await statement above.
         if (this.applyingRemote) return;
 
-        const localBlocks = (saved?.blocks || []).map((b) => ({ id: b.id, type: b.type, data: b.data }));
-        const localIds = new Set(localBlocks.map((b) => b.id));
+        // Deduplicate by id. EditorJS should never report the same block id
+        // twice, but a mis-applied remote patch can leave the editor in that
+        // state, and _findYIndexById() below resolves BOTH copies to the same
+        // first match - so the second copy deletes that entry and then tries
+        // to insert past the (now shorter) array, which is exactly Yjs's
+        // "Length exceeded!". Dropping the extras here also stops one bad
+        // local render from propagating into the CRDT, where it would corrupt
+        // the document for every other connected client rather than just this
+        // one.
+        const seenIds = new Set();
+        const localBlocks = [];
+        for (const b of (saved?.blocks || [])) {
+            if (!b || seenIds.has(b.id)) continue;
+            seenIds.add(b.id);
+            localBlocks.push({ id: b.id, type: b.type, data: b.data });
+        }
 
         const currentSnapshot = this.yarray.toArray();
         if (this._blocksEqual(currentSnapshot, localBlocks)) return;
@@ -170,7 +184,8 @@ export default class ContentBinding {
             // This code removes each yarray entry for a block that no
             // longer exists locally.
             for (let i = this.yarray.length - 1; i >= 0; i--) {
-                if (!localIds.has(this.yarray.get(i).id)) this.yarray.delete(i, 1);
+                const entry = this.yarray.get(i);
+                if (!entry || !seenIds.has(entry.id)) this.yarray.delete(i, 1);
             }
 
             // This code inserts, updates, or reorders entries, to match
@@ -182,7 +197,7 @@ export default class ContentBinding {
                 const idx = this._findYIndexById(lb.id);
 
                 if (idx < 0) {
-                    this.yarray.insert(index, [lb]);
+                    this._insertAt(index, lb);
                     return;
                 }
 
@@ -190,15 +205,28 @@ export default class ContentBinding {
                 const changed = existing.type !== lb.type || JSON.stringify(existing.data) !== JSON.stringify(lb.data);
                 if (changed || idx !== index) {
                     this.yarray.delete(idx, 1);
-                    this.yarray.insert(index, [lb]);
+                    this._insertAt(index, lb);
                 }
             });
         }, 'local');
     }
 
+    /**
+     * Yjs throws "Length exceeded!" for any insert index past the array's
+     * current length, and that length moves under the reconciliation loop on
+     * every delete/insert. Clamping keeps one drifted index from aborting the
+     * whole transaction (which would leave the CRDT half-updated); worst case
+     * the block lands at the end and the next pass reorders it.
+     */
+    _insertAt(index, block) {
+        const at = Math.max(0, Math.min(index, this.yarray.length));
+        this.yarray.insert(at, [block]);
+    }
+
     _findYIndexById(blockId) {
         for (let i = 0; i < this.yarray.length; i++) {
-            if (this.yarray.get(i).id === blockId) return i;
+            const entry = this.yarray.get(i);
+            if (entry && entry.id === blockId) return i;
         }
         return -1;
     }
@@ -230,13 +258,27 @@ export default class ContentBinding {
             const localSaved = await this.editor.save();
             const localBlocks = localSaved?.blocks || [];
 
+            // Snapshot of local block DATA only, keyed by id, used solely for
+            // the "did this block's content change" comparison below.
+            // Positions are deliberately NOT taken from here: every
+            // delete/insert/move in the loops below shifts the index of every
+            // block after it, so a snapshot taken once up front is stale from
+            // the first mutation onward. Reading positions from that stale
+            // snapshot produced EditorJS's "indices cannot be lower than 0 or
+            // greater than the amount of blocks" warning, and - once the drift
+            // let a block be inserted that was already present - the duplicate
+            // ids that then made syncLocalToYArray() throw Yjs's "Length
+            // exceeded!". Positions are re-read live, per iteration, via
+            // _editorBlockIds().
+            const localDataById = new Map(localBlocks.map((b) => [b.id, b.data]));
             const remoteIds = new Set(remoteBlocks.map((b) => b.id));
 
             // This code deletes each local block that no longer exists
-            // in the remote data.
+            // in the remote data. The index is resolved against the live list
+            // each time, since each delete reindexes everything after it.
             for (const lb of localBlocks) {
                 if (remoteIds.has(lb.id)) continue;
-                const idx = this.editor.blocks.getBlockIndex(lb.id);
+                const idx = this._editorBlockIds().indexOf(lb.id);
                 if (idx >= 0) this.editor.blocks.delete(idx);
             }
 
@@ -244,14 +286,18 @@ export default class ContentBinding {
             // remote order.
             for (let index = 0; index < remoteBlocks.length; index++) {
                 const rb = remoteBlocks[index];
-                const local = localBlocks.find((lb) => lb.id === rb.id);
+                let ids = this._editorBlockIds();
 
-                if (!local) {
-                    this.editor.blocks.insert(rb.type, rb.data, {}, index, false, false, rb.id);
+                if (ids.indexOf(rb.id) < 0) {
+                    // Clamp: EditorJS silently ignores an out-of-range insert
+                    // index, which would leave this block missing entirely and
+                    // desync the two sides again on the next pass.
+                    const at = Math.min(index, ids.length);
+                    this.editor.blocks.insert(rb.type, rb.data, {}, at, false, false, rb.id);
                     continue;
                 }
 
-                const changed = JSON.stringify(local.data) !== JSON.stringify(rb.data);
+                const changed = JSON.stringify(localDataById.get(rb.id)) !== JSON.stringify(rb.data);
                 const recentlyEditedLocally = (Date.now() - (this.recentLocalEdits.get(rb.id) || 0)) < this.conflictWindowMs;
 
                 if (changed && recentlyEditedLocally) {
@@ -260,9 +306,15 @@ export default class ContentBinding {
                     await this.editor.blocks.update(rb.id, rb.data);
                 }
 
-                const currentIndex = this.editor.blocks.getBlockIndex(rb.id);
-                if (currentIndex !== index && currentIndex >= 0) {
-                    this.editor.blocks.move(index, currentIndex);
+                // Re-read after the update above: blocks.update() can replace
+                // the block instance, and earlier iterations have mutated the
+                // list. Both indices passed to move() must be valid against
+                // the list as it exists right now.
+                ids = this._editorBlockIds();
+                const currentIndex = ids.indexOf(rb.id);
+                const target = Math.min(index, ids.length - 1);
+                if (currentIndex >= 0 && target >= 0 && currentIndex !== target) {
+                    this.editor.blocks.move(target, currentIndex);
                 }
             }
         } finally {
@@ -270,6 +322,25 @@ export default class ContentBinding {
         }
     }
 
+    /**
+     * The editor's block ids in their current on-screen order.
+     *
+     * Deliberately not editor.blocks.getBlockIndex(id): that API returns
+     * `undefined` (not -1) for an unknown id AND logs its own "There is no
+     * block with id" warning as a side effect, so probing it for presence
+     * both breaks `< 0` checks and spams the console. Walking the live list
+     * by index answers presence and position together, with no side effects.
+     */
+    _editorBlockIds() {
+        const ids = [];
+        const count = this.editor.blocks.getBlocksCount();
+        for (let i = 0; i < count; i++) {
+            const block = this.editor.blocks.getBlockByIndex(i);
+            if (block) ids.push(block.id);
+        }
+        return ids;
+    }
+
     /**
      * A user action from the PresenceTune's restore button or suppress
      * button calls this method. The "restore" action synchronizes this
diff --git a/node_modules/editorjs-yjs/src/index.js b/node_modules/editorjs-yjs/src/index.js
index b12adf6..791b80a 100644
--- a/node_modules/editorjs-yjs/src/index.js
+++ b/node_modules/editorjs-yjs/src/index.js
@@ -164,9 +164,59 @@ export default class EditorYjs {
             this._holderEl.addEventListener('focusout', this._onFocusOut);
         }
 
+        // Wait for the room's existing state to arrive BEFORE handing over to
+        // ContentBinding.attach(), which decides "does this room already have
+        // content?" by reading this.yarray.length.
+        //
+        // Without this wait that check is meaningless: the WebsocketProvider
+        // connects asynchronously, so at attach() time the local Y.Doc is
+        // still empty no matter what the room actually holds. Every client
+        // therefore took the "empty room" branch and pushed its OWN full copy
+        // of the document; when the server state then merged in, the CRDT kept
+        // both - the room's blocks AND the freshly pushed duplicates. Y.Array
+        // items are identified by (client, clock), not by block id, so
+        // re-inserting "the same" blocks genuinely appends new entries rather
+        // than matching the existing ones. Each page load added another full
+        // copy (observed live: 235 -> 267 -> 275 blocks over three loads), and
+        // a host app persisting the room (e.g. via an autosave bridge) writes
+        // that growth straight into its database.
+        //
+        // Times out rather than hanging: if the relay is unreachable the
+        // provider never syncs, and editing must still work - falling through
+        // with an empty yarray makes ContentBinding push the local document,
+        // which is the correct offline behaviour.
+        await this._connectReady;
+        await this._whenSynced();
+
         await this.binding.attach(editor);
     }
 
+    /**
+     * Resolves once the provider has completed its initial sync with the room
+     * (or after `timeoutMs`, so an unreachable relay degrades to offline
+     * editing instead of blocking the editor forever).
+     *
+     * @param {number} [timeoutMs]
+     * @returns {Promise<boolean>} true if genuinely synced, false on timeout.
+     */
+    _whenSynced(timeoutMs = 5000) {
+        if (this.provider.synced) return Promise.resolve(true);
+
+        return new Promise((resolve) => {
+            let settled = false;
+            const finish = (value) => {
+                if (settled) return;
+                settled = true;
+                clearTimeout(timer);
+                try { this.provider.off('sync', onSync); } catch (e) { /* older y-websocket */ }
+                resolve(value);
+            };
+            const onSync = (isSynced) => { if (isSynced) finish(true); };
+            const timer = setTimeout(() => finish(false), timeoutMs);
+            this.provider.on('sync', onSync);
+        });
+    }
+
     /** Pass this property directly as EditorJS's `onChange` option. */
     get onChange() {
         return this.binding.handleLocalChange;
-- 
