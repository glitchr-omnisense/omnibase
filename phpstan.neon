# Level 6, and phpstan-baseline.neon lists the violations there were when the CI started (2026-10-21,
# written by glitchr-studio/ci's baseline workflow), re-generated on 2026-11-09 with the debt left by the moves of
# the plan "omnibase agnostic", to be paid down gradually: the CI fails on any other. Fix one, then drop its entry.
# extension.neon: what PHPStan must know of omnibase, as an application includes it (the finder language).
# tests/phpstan-bootstrap.php: the App\ classes the core names are the Base\ ones, aliased as at run time.
#
# The bridges' src/Omnibase (omnibridge/symfony's: the core's Symfony host; omnibridge/doctrine's: its Doctrine
# persistence) are analysed here, from vendor/, where the core's require-dev installs both (with DoctrineBundle
# and HWI): they extend and implement the core's classes, which the bridges' own installs do not have, so their
# own phpstan.neon leaves those folders out. Same level as the core's. phpstan-bridges-baseline.neon lists their
# violations as of 2026-11-09 (1,472 entries, 1,630 errors), and the CI fails on any other. To write both
# baselines again: generate one with neither included (--generate-baseline), then put its entries whose path is
# under vendor/ in phpstan-bridges-baseline.neon and the others in phpstan-baseline.neon (a core trait used by a
# bridge's class is reported under the trait's own path: the core's file). The job installs the bridges as a
# consumer gets them, so a bridge's change is analysed here once Packagist serves it.
includes:
    - extension.neon
    - phpstan-baseline.neon
    - phpstan-bridges-baseline.neon

parameters:
  level: 6
  paths:
    - src
    - tests
    - vendor/omnibridge/symfony/src/Omnibase
    - vendor/omnibridge/doctrine/src/Omnibase
  # Classes that cannot load on purpose (Tests\Base\Fixtures\Absent\* is never defined): the
  # warm-up's fixtures of an optional extension whose parent package is absent.
  excludePaths:
    - tests/Fixtures/Warmup/OptionalExtension.php
    - tests/Fixtures/Warmup/OptionalImplementation.php
  bootstrapFiles:
    - tests/phpstan-bootstrap.php
  tmpDir: .tmp
  reportUnmatchedIgnoredErrors: false
