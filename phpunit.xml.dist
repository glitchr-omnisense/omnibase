<?xml version="1.0" encoding="UTF-8"?>
<!-- Kept compatible with both PHPUnit 10 (CI, require-dev) and PHPUnit 9.6
     (host app's simple-phpunit bridge used by `make tests`). -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         bootstrap="tests/bootstrap.php"
         colors="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
