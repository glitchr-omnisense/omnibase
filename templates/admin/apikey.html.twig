{% extends "@EasyAdmin/layout.html.twig" %}

{% block content_icon  %}{{ "admin_apikey"|iconify|closest(1)|raw }}{% endblock %}
{% block content_title %}{{ title("admin_apikey") }}{% endblock %}
{% block content_excerpt  %}{{ excerpt("admin_apikey") }}{% endblock %}
{% block content %}

{% if form is defined and form.children|length > 1 %}
    <div class="page-apikey">
    {{ form(form) }}
    </div>
{% else %}
    <div class="text-center">
    {{"@controllers.admin_apikey.empty"|trans}}
    </div>
{% endif %}

{% endblock %}
