{% extends "@EasyAdmin/layout.html.twig" %}

{% block content_icon %}{{ "admin_settings"|iconify|closest(1)|raw  }}{% endblock %}
{% block content_title %}{{ title("admin_settings") }}{% endblock %}
{% block content_excerpt  %}{{ excerpt("admin_settings") }}{% endblock %}
{% block content %}

{% if form is defined and form.children|length > 1 %}
    <div class="page-settings">
    {{ form(form) }}
    </div>
{% else %}
    <div class="text-center">
    {{ "@controllers.admin_settings.empty"|trans }}
    </div>
{% endif %}

{% endblock %}
