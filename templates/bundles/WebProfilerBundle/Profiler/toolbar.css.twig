.sf-toolbar-closed .sf-toolbarreset { padding: 0; }
.sf-toolbar {

    margin: 1.5em 3em 1.5em 0em;
}
.sf-toolbarreset {
    
    padding: 0.25em 0em 0.25em 1em;
    border-radius: 1em;
    background-color: #222C;
    box-shadow: inset 0 1px 0 #222C, 0 -1px 0 rgba(0, 0, 0, 0.5);

    position: initial !important;

    display: flex;
    overflow: scroll;
    width: calc(95vw - 4em);
    margin-right: 0em;
}

.sf-cancel-button {
    border-radius: 1em;
    border: 0;
}

.sf-toolbarreset {
    width: calc(95vw - 4em);
    transition: all 0.1s, width 0s;
    cursor: move; /* Fallback for unsupported browsers */
    cursor: grab;
    cursor: -moz-grab;
    cursor: -webkit-grab;
}
.sf-toolbar-closed .sf-toolbarreset::before { display:none; }
.sf-toolbarreset::before {
    content: '';
    width: 5px;
    margin: 6.5px 0;
    cursor: ew-resize;
    background: linear-gradient(to right, #999 0 1px, transparent 0px 6px, #999 6px 9px);
    z-index: 1000;
    pointer-events: auto;
    min-width:5px;
}

.sf-toolbarreset::-webkit-scrollbar { display: none; }
.sf-toolbarreset {
  scrollbar-width: none;
  -ms-overflow-style: none; 
}

.sf-toolbar-closed .sf-toolbarreset .sf-toolbar-toggle-button
{
    padding: 1px;
}

.sf-toolbarreset .sf-toolbar-toggle-button
{
    background-color: #222C;
