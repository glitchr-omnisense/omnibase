{# ── Inline FOUC guard for the Symfony Web Debug Toolbar ────────────
   The Symfony toolbar_js.html.twig (included below) outputs the toolbar
   markup directly into the page, with the "Loading the web debug toolbar…"
   placeholder content from cancel.html.twig inside #sfwdt{token}. The
   stylesheet that styles all of that lives at /_wdt_stylesheet and is
   referenced by a <link> at the END of the toolbar markup — so for the
   ~100-300ms between HTML parse and stylesheet arrival, the placeholder
   shows unstyled (light-blue background, raw "Loading…" / "Cancel" text).
   This inline <style> hides the toolbar until the loaded toolbar content
   appears — the loaded state has a .sf-toolbarreset child; the cancel
   placeholder doesn't. :has() is Chrome 105+, Safari 15.4+, Firefox 121+. #}
<style>
    /* `display: none` (not visibility: hidden) so the toolbar markup occupies
       zero layout space until the loaded state is reached — visibility:hidden
       still allocates the bounding box, which was leaking the unstyled
       "Loading the web debug toolbar..." placeholder above the page content
       during the brief window between HTML parse and /_wdt_stylesheet load,
       AND during transparent.js SPA navigations when loadToolbar replaces
       the toolbar innerHTML with the cancel placeholder for retries.
       Belt-and-suspenders: also gate on the outer .sf-minitoolbar element. */
    .sf-toolbar,
    .sf-toolbar .sf-minitoolbar { display: none !important; }
    .sf-toolbar:has(.sf-toolbarreset),
    .sf-toolbar:has(.sf-toolbarreset) .sf-minitoolbar {
        display: block !important;
        animation: sf-toolbar-fade-in 0.15s ease-in;
    }
    @keyframes sf-toolbar-fade-in { from { opacity: 0 } to { opacity: 1 } }

    /* ── Hide toolbar in lockstep with #page fade during SPA nav ─────────
       The toolbar div is rendered OUTSIDE #page (at the end of <body>), so
       while `.transparent.loading #page { opacity:0 }` fades the page, the
       toolbar stays at opacity:1 — leaving the toolbar as the ONLY visible
       element on screen during transitions. If Symfony's loadToolbar is
       mid-XHR for the new request's profile, the inner state shows the
       cancel placeholder (light-blue background, "Loading the web debug
       toolbar..."), and that's what users actually see between clicks.
       Hiding the toolbar entirely while LOADING is set on <html> matches
       the page's behavior and removes the placeholder leak. Specificity:
       `.transparent.loading .sf-toolbar` = 3 classes > 2 for `:has`, so
       this wins regardless of the loaded-vs-cancel state inside. */
    html.transparent.loading .sf-toolbar { display: none !important; }
</style>

{% include '@!WebProfiler/Profiler/toolbar_js.html.twig' %}

<script{% if csp_script_nonce is defined and csp_script_nonce %} nonce="{{ csp_script_nonce }}"{% endif %}>

(function() {

    if (window.__sfToolbarDraggableInitialized) return;
    window.__sfToolbarDraggableInitialized = true;

    var toolbar = document.querySelector('.sf-toolbar');
    var toolbarReset = document.querySelector('.sf-toolbarreset');
    if (!toolbar || !toolbarReset) return;

    const STORAGE_KEY = 'sf-toolbar-position';
    const WIDTH_STORAGE_KEY = 'sf-toolbar-width';
    const DRAG_THRESHOLD = 5;
    const PADDING = 16;

    let dragging = false;
    let resizing = false;
    let suppressClick = false;
    let startX = 0, startY = 0;
    let offsetX = 30;
    let currentX = 0, currentY = 0;
    let currentWidth = toolbarReset.offsetWidth;
    let minimize = false;

    var initialWidth = toolbarReset.offsetWidth;
    function restoreToolbarWidth() {

        const savedWidth = localStorage.getItem(WIDTH_STORAGE_KEY);
        if (!savedWidth) return;

        const w = clampWidth(parseInt(savedWidth, 10));
        toolbarReset.style.width = w + 'px';
    }

    const observer = new MutationObserver(() => {

        var _toolbarReset = document.querySelector('.sf-toolbarreset');
        if(!_toolbarReset) return;

        if (toolbarReset != _toolbarReset) {
            toolbarReset = _toolbarReset;
            toolbar = document.querySelector('.sf-toolbar') || toolbar;
            initialWidth = toolbarReset.offsetWidth;
            currentWidth = initialWidth;
        }

        restoreToolbarWidth();
        updateToolbarInversion();
    });

    observer.observe(document.documentElement, {
        childList: true,
        subtree: true
    });
    
    function clampPosition(x, y) {
        const toolbarRect = toolbar.getBoundingClientRect();
        const maxX = 2*PADDING;
        const maxY = 0;
        const minX = -(window.innerWidth - 5*PADDING);
        const minY = -(window.innerHeight - toolbarRect.height - 2 * PADDING);

        return { x: Math.min(maxX, Math.max(minX, x)), y: Math.min(maxY, Math.max(minY, y)) };
    }

    function clampWidth(width) {
        const minWidth = 200;
        const maxWidth = initialWidth;
        return Math.min(maxWidth, Math.max(minWidth, width));
    }

    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
        try {
            const pos = JSON.parse(saved);
            const clamped = clampPosition(pos.x || 0, pos.y || 0);
            currentX = clamped.x;
            currentY = clamped.y;
            toolbar.style.transform = `translate(${currentX}px, ${currentY}px)`;
            offsetX = currentX;
        } catch (e) {}
    }

    if (toolbar._draggableListeners) {
        const { mousedown, mousemove, mouseup, click, dblclick, resizeStart } = toolbar._draggableListeners;
        document.removeEventListener('mousedown', mousedown);
        document.removeEventListener('mousemove', mousemove);
        document.removeEventListener('mouseup', mouseup);
        document.removeEventListener('click', click, true);
        document.removeEventListener('dblclick', dblclick);
        document.removeEventListener('mousedown', resizeStart);
    }

    const mousedown = e => {
        
        if (!e.target.closest('.sf-toolbar-toggle-button')) return;
        
        dragging = true;
        suppressClick = false;
        
        startX = e.clientX;
        startY = e.clientY;
        
        e.preventDefault();
        e.stopPropagation();
    };

    const resizeStart = e => {

        const toolbarRect = toolbar.getBoundingClientRect();

        const beforeWidth = 15;
        const beforeLeft = toolbarRect.left;
        const beforeRight = beforeLeft + beforeWidth;

        const beforeTop = toolbarRect.top;
        const beforeBottom = toolbarRect.bottom;
        
        if (e.clientX >= beforeLeft && e.clientX <= beforeRight && e.clientY >= beforeTop && e.clientY <= beforeBottom && !resizing) {
            resizing = true;
            e.preventDefault();
            e.stopPropagation();
        }
    };

    const mousemove = e => {

        if (dragging) {
            
            const dx = e.clientX - startX;
            const dy = e.clientY - startY;
            if (Math.abs(dx) > DRAG_THRESHOLD || Math.abs(dy) > DRAG_THRESHOLD) suppressClick = true;
            
            const clamped = clampPosition(currentX + dx, currentY + dy);
            toolbar.style.transform = `translate(${clamped.x}px, ${clamped.y}px)`;
            offsetX = clamped.x;

            updateToolbarInversion();

        } else if (resizing) {
            const dx = e.clientX - (offsetX + 10);
            let newWidth = clampWidth(initialWidth - dx);

            toolbarReset.style.width = newWidth + 'px';
        }
    };

    const mouseup = e => {
        if (dragging) {
            dragging = false;
            const dx = e.clientX - startX;
            const dy = e.clientY - startY;
            const clamped = clampPosition(currentX + dx, currentY + dy);
            currentX = clamped.x;
            currentY = clamped.y;
            localStorage.setItem(STORAGE_KEY, JSON.stringify({ x: currentX, y: currentY }));
        }
        
        if(resizing) {
            localStorage.setItem(WIDTH_STORAGE_KEY, toolbarReset.offsetWidth-Math.abs(offsetX)-PADDING);
            resizing = false;
        }
    };

    const click = e => {
        if (!e.target.closest('.sf-toolbar-toggle-button')) return;
        if (!suppressClick) return;
        e.stopImmediatePropagation();
        e.preventDefault();
        suppressClick = false;
    };

    const dblclick = e => {
        if (!e.target.closest('.sf-toolbar-toggle-button')) return;
        const clamped = clampPosition(minimize ? 2*PADDING : -(window.innerWidth - 5*PADDING), 0);
        currentX = clamped.x;
        currentY = clamped.y;
        toolbar.style.transform = `translate(${clamped.x}px, ${clamped.y}px)`;
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ x: currentX, y: currentY }));
        localStorage.removeItem(WIDTH_STORAGE_KEY);
        minimize = !minimize;
    };

    var minimizeWidth = false;
    const resizeDblClick = e => {
        const rect = toolbar.getBoundingClientRect();

        const edgeWidth = 15;
        const left = rect.left;
        const right = left + edgeWidth;

        if (
            e.clientX >= left &&
            e.clientX <= right &&
            e.clientY >= rect.top &&
            e.clientY <= rect.bottom
        ) {
            const toolbarReset = document.querySelector('.sf-toolbarreset');
            if (!toolbarReset) return;

            var width = minimizeWidth ? initialWidth-Math.abs(offsetX)+2*PADDING : 65;
            toolbarReset.style.width = (width) + 'px';
            localStorage.setItem(WIDTH_STORAGE_KEY, width);
            minimizeWidth = !minimizeWidth;

            resizing = false;
            e.preventDefault();
            e.stopPropagation();
        }
    };

    function updateToolbarInversion() {
        const rect = toolbarReset.getBoundingClientRect();
        const halfY = rect.top + rect.height / 2;
        toolbarReset.classList.toggle('inverted', halfY < window.innerHeight / 2);
    }

    document.addEventListener('mousedown', mousedown);
    document.addEventListener('mousedown', resizeStart);
    document.addEventListener('mousemove', mousemove);
    document.addEventListener('mouseup', mouseup);
    document.addEventListener('click', click, true);
    document.addEventListener('dblclick', dblclick);
    document.addEventListener('dblclick', resizeDblClick);
    document.addEventListener('resize', updateToolbarInversion);

    toolbar._draggableListeners = { mousedown, mousemove, mouseup, click, dblclick, resizeStart };

})();
</script>

<script{% if csp_script_nonce is defined and csp_script_nonce %} nonce="{{ csp_script_nonce }}"{% endif %}>
// ─── Defensive patch for Symfony WebProfilerBundle toolbar ──────────
// Wraps each .sf-toolbar-block's onmouseover so it no-ops when the
// expected .sf-toolbar-info child is missing — fixes the
// "TypeError: undefined is not an object (evaluating 'toolbarInfo.offsetWidth')"
// that fires from the upstream handler at
//   vendor/symfony/web-profiler-bundle/Resources/views/Profiler/toolbar_js.html.twig#L598
// when a toolbar block is rendered without its info child (which can happen
// in some Symfony toolbar states, including after AJAX navigations).
(function() {
    function safeguardToolbarBlocks() {
        document.querySelectorAll('.sf-toolbar-block').forEach(function(block) {
            var orig = block.onmouseover;
            if (typeof orig !== 'function') return;
            // Skip if our wrapper is already the current handler.
            if (orig.__sfSafe) return;
            var safe = function(e) {
                var info = this.querySelectorAll && this.querySelectorAll('.sf-toolbar-info')[0];
                if (!info) return;
                return orig.call(this, e);
            };
            safe.__sfSafe = true;
            block.onmouseover = safe;
        });
    }

    // Initial pass for blocks already in DOM.
    safeguardToolbarBlocks();

    // Watch for new toolbar blocks (Symfony re-renders them on every AJAX
    // request via loadToolbar). On each DOM mutation, run the safeguard
    // again — idempotent thanks to the __sfSafe flag check.
    var observer = new MutationObserver(function() {
        safeguardToolbarBlocks();
    });
    observer.observe(document.documentElement, { childList: true, subtree: true });
})();
</script>