{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}

        {% set icon %}
            {{ include('@WebProfiler/localizer_icon.svg.twig', { fill_color: '#AAA', height: '24' }) }}
        {% endset %}

        {%- set text -%}
            <div class="sf-toolbar-info-group">
                <div class="sf-toolbar-info-piece">
                    <b>Timezone:</b>
                    <span class="sf-toolbar-status">{{ collector.data['timezone']|default('N/A') }}</span>
                </div>
                <div class="sf-toolbar-info-piece">
                    <b>Locale:</b>
                    <span class="sf-toolbar-status">
                    {% for locale in app.localizer.getAvailableLocales()|default(['N/A']) %}
                        {% set current = (locale == collector.data['locale']) ? "active" : null %}
                        {% if not current %} <a href="{{ path("_switch_locale", {_locale: locale}) }}"> {% endif %}
                            {{locale|country}}
                        {% if not current %} </a> {% endif %}
                    {% endfor %}
                    </span>
                </div>
            </div>
        {%- endset -%}

        {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { 'link': true }) }}
        {# Spacer only — must NOT carry `sf-toolbar-block`, otherwise the WebProfiler
           toolbar.js mouseover handler targets it and dereferences a missing
           `.sf-toolbar-info` (TypeError: toolbarInfo.offsetWidth). #}
        <span class="sf-toolbar-spacer sf-toolbar-block-spacer"></span>
{% endblock %}

{% block menu %}
    <span class="label">
        <span class="icon">{{ include('@WebProfiler/localizer_icon.svg.twig', { fill_color: '#AAA', height: '24' }) }}</span>
        <strong>Localizer</strong>
    </span>
{% endblock %}

{% block panel %}

    {% for title, data in collector.data %}
        {% if not (title starts with '_') %}
            <h2>{{ title|raw }}</h2>
            {% if data is not iterable or data is empty %}
                <div class="empty"><p>No specific information available.</p></div>
            {% else %}
                {{ include('@WebProfiler/Profiler/table.html.twig', {data:data}, with_context = false) }}
            {% endif %}
        {% endif %}
    {% endfor %}

{% endblock %}
