{% extends 'layout1.html.twig' %}

{# The member's notification center (NotificationController::Index,
   Base\Screen\Account\NotificationsPage): every notification with something
   to show, newest first, grouped by day (each one's group, by the screen's
   clock). The
   "notifications" script (assets/notifications.js) marks entries read or
   unread, deletes them and toggles push through the root's data attributes;
   without it the list still reads, and each entry still links its page. #}

{% block title %}{{ '@messages.notifications.title'|trans }}{% endblock %}
{% block content %}


<article class="wrapper notifications-page"
         data-notifications
         data-csrf="{{ screen.token }}"
         data-read-url="{{ screen.readUrl }}"
         data-latest-url="{{ screen.latestUrl }}"
         data-delete-url="{{ screen.deleteUrl }}"
         data-push-key="{{ screen.push ? screen.pushKey : '' }}"
         data-push-subscribe-url="{{ screen.subscribeUrl }}"
         data-push-unsubscribe-url="{{ screen.unsubscribeUrl }}">

    <h2>{{ '@messages.notifications.title'|trans }}
        <span class="badge bg-primary" data-notifications-badge data-count="{{ screen.unread }}" {{ screen.unread ? '' : 'hidden' }}>{{ screen.unread }}</span>
    </h2>

    <div class="notifications-toolbar d-flex flex-wrap gap-2">
        {% if screen.unreadOnly %}
            <a class="btn btn-sm btn-outline-primary" href="{{ screen.allUrl }}">{{ '@messages.notifications.all'|trans }}</a>
        {% endif %}
        <button type="button" class="btn btn-sm btn-outline-primary" data-notifications-read-all>
            <i class="fa-solid fa-check-double"></i> {{ '@messages.notifications.readAll'|trans }}
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-notifications-delete-read>
            <i class="fa-solid fa-trash-can"></i> {{ '@messages.notifications.deleteRead'|trans }}
        </button>
        {% if screen.push %}
            <button type="button" class="btn btn-sm btn-outline-secondary" data-push-toggle hidden
                    data-label-off="{{ '@messages.notifications.push.enable'|trans }}"
                    data-label-on="{{ '@messages.notifications.push.disable'|trans }}"
                    data-label-denied="{{ '@messages.notifications.push.denied'|trans }}">
                <i class="fa-solid fa-mobile-screen"></i> <span data-push-label>{{ '@messages.notifications.push.enable'|trans }}</span>
            </button>
        {% endif %}
    </div>
    {% if screen.push %}
        <p class="notifications-hint text-muted small">{{ '@messages.notifications.push.hint'|trans }}</p>
    {% endif %}

    {% set group = null %}
    <ul class="notifications-list list-unstyled">
    {% for notification in screen.notifications %}
        {# its day's group: today, yesterday, week, earlier - Base\Screen\Account\Notification::$group #}
        {% set current = notification.group %}
        {% if current != group %}
            {% set group = current %}
            <li class="notifications-group"><h3 class="h6 text-muted mt-3">{{ ('@messages.notifications.group.' ~ group)|trans }}</h3></li>
        {% endif %}
        <li class="notification d-flex align-items-start {{ notification.isRead ? '' : 'is-unread' }}" data-notification-item data-id="{{ notification.id }}">
            <a class="notification-link flex-grow-1" href="{{ notification.url ?? '#' }}">
                <strong>{{ notification.title }}</strong>
                {% if notification.content is not null %}<span class="d-block">{{ notification.content|slice(0, 240) }}</span>{% endif %}
                {% if notification.sentAt %}<time class="notification-time" datetime="{{ notification.sentAt|date('c') }}">{{ notification.sentAt|date('d/m/Y H:i') }}</time>{% endif %}
            </a>
            <span class="notification-actions d-flex">
                <button type="button" class="btn btn-raw {{ notification.isRead ? 'is-read' : '' }}" data-notification-read-toggle
                        data-label-read="{{ '@messages.notifications.markRead'|trans }}"
                        data-label-unread="{{ '@messages.notifications.markUnread'|trans }}"
                        title="{{ (notification.isRead ? '@messages.notifications.markUnread' : '@messages.notifications.markRead')|trans }}"
                        aria-label="{{ (notification.isRead ? '@messages.notifications.markUnread' : '@messages.notifications.markRead')|trans }}"><i class="fa-solid fa-check"></i></button>
                <button type="button" class="btn btn-raw" data-notification-delete
                        title="{{ '@messages.notifications.delete'|trans }}" aria-label="{{ '@messages.notifications.delete'|trans }}"><i class="fa-solid fa-xmark"></i></button>
            </span>
        </li>
    {% else %}
        <li class="notifications-empty text-muted">{{ '@messages.notifications.empty'|trans }}</li>
    {% endfor %}
    </ul>
</article>
{# Encore renders an entry once per request: nothing doubles on a site whose
   layout already loads it for its bell. #}
{{ encore_entry_script_tags('notifications') }}
{% endblock %}
