{% extends 'layout1.html.twig' %}

{% block title %}{{ user }}{% endblock %}
{% block content %}

    {% if user is defined %}

    {# Only the account holder - or an administrator - sees anything beyond
       the public header. Everything below this flag is about the account,
       not about the person's public presence on the site. #}
    {% set isOwnProfile = app.user == user %}
    {% set canSeeAccount = isOwnProfile or is_granted("ROLE_ADMIN") %}

    <article class="wrapper extended">
        <div class="header">

            <ul class="field-avatar">
                <li class="keep-opacity">{{ user.getFormattedAvatar()|raw }}</li>
            </ul>

            <div class="text d-flex flex-column">

                <h1>
                    {{ '@messages.profile.member'|trans }} #{{ user.id }}: {{ user }}
                    {% if user.isOnline() %}
                        <span class="badge bg-success" title="{{'@messages.profile.online'|trans}}">{{'@messages.profile.online'|trans}}</span>
                    {% elseif user.isActive() %}
                        <span class="badge bg-warning" title="{{'@messages.profile.recentlyActive'|trans}}">{{'@messages.profile.recentlyActive'|trans}}</span>
                    {% endif %}
                </h1>

                <div class="roles mb-1">
                    {# Domain is "enums" (plural) and the catalogue is snake_case
                       with a _singular/_plural suffix - see TranslationEnumsCommand,
                       which generates exactly this shape. The previous
                       '@enum.userRole.' ~ role built none of that, so every badge
                       rendered its raw key (e.g. "@enum.userRole.ROLE_EDITOR"). #}
                    {% for role in user.roles %}
                        <span class="badge bg-secondary">{{ ('@enums.user_role.' ~ role|lower ~ '._singular')|trans }}</span>
                    {% endfor %}
                </div>

                <div class="info">
                    {{ '@messages.profile.registered'|trans([
                        user.createdAt()|datetime("dd MMMM YYYY"),
                        user.createdAt()|datetime("HH:mm")
                    ])|raw }}&nbsp

                    {% if canSeeAccount %}
                        - <a href="{{ path('user_profileEdit', {'id':user.id}) }}">{{ '@messages.profile.edit'|trans }}</a>
                    {% endif %}
                    {% if isOwnProfile %}
                        - <a href="{{ path('user_settings') }}">{{ '@forms.settings.title'|trans }}</a>
                        - <a href="{{ path('security_logout') }}">{{ '@messages.profile.logout'|trans }}</a>
                    {% endif %}
                </div>

                <div class="stats">
                    {{ '@messages.profile.last_seen'|trans([
                        user.updatedAt()|datetime("dd MMMM YYYY"),
                        user.updatedAt()|datetime("HH:mm")
                    ])|raw }}&nbsp
                </div>

                <div class="activity d-flex mt-2">
                    <div class="me-4">
                        <strong>{{ user.threads|length }}</strong> {{'@messages.profile.threads'|trans}}
                    </div>
                    <div class="me-4">
                        <strong>{{ user.likes|length }}</strong> {{'@messages.profile.likes'|trans}}
                    </div>
                </div>
            </div>
        </div>

    </article>

    {# Most recent published writing. Threads come back in no particular
       order and include drafts, so sort and filter here rather than trusting
       the collection - and cap it, because an author with hundreds of
       articles should not turn their profile into an archive page. #}
    {% set published = user.threads|filter(t => t.isPublished() and t.title)|sort((a, b) => (b.publishedAt ?? b.createdAt) <=> (a.publishedAt ?? a.createdAt))|slice(0, 5) %}
    {% if published|length %}
    <article class="wrapper extended">
        <h3>{{ '@messages.profile.recentThreads'|trans }}</h3>
        <ul class="list-group">
            {% for thread in published %}
                <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <a href="{{ thread.__toLink() }}">{{ thread.title }}</a>
                    <small class="text-muted">{{ (thread.publishedAt ?? thread.createdAt)|datetime("dd MMMM YYYY") }}</small>
                </li>
            {% endfor %}
        </ul>
    </article>
    {% endif %}

    {% if canSeeAccount %}
    <article class="wrapper extended">
        <h3>{{ '@messages.profile.accountSecurity'|trans }}</h3>
        <ul class="list-group">
            {% if security_policy.isTwoFactorAvailable() %}
            <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                {{ '@forms.settings.twoFactor'|trans }}
                {% if security_policy.hasSecondFactor(user) %}
                    <span class="badge bg-success">{{ '@forms.settings.enabled'|trans }}</span>
                {% else %}
                    <span class="badge bg-secondary">{{ '@messages.profile.notEnabled'|trans }}</span>
                {% endif %}
            </li>
            {% endif %}
            {% if security_policy.arePasskeysAvailable() %}
            <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                {{ '@forms.settings.passkeys'|trans }}
                <span class="badge {{ user.getPasskeys()|length ? 'bg-success' : 'bg-secondary' }}">{{ user.getPasskeys()|length }}</span>
            </li>
            {% endif %}
            <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span><i class="fa-fw fa-brands fa-google"></i> Google</span>
                {% if user.getIdentityProvider() == 'google' %}
                    <span class="badge bg-success">{{ '@forms.settings.connected'|trans }}</span>
                {% else %}
                    <span class="badge bg-secondary">{{ '@messages.profile.notConnected'|trans }}</span>
                {% endif %}
            </li>
            <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                {{ '@forms.settings.preferences'|trans }}
                <small class="text-muted">{{ user.getLocale() }} &middot; {{ user.getTimezone() }}</small>
            </li>
        </ul>
        {% if isOwnProfile %}
        <a class="btn btn-sm btn-primary mt-2" href="{{ path('user_settings') }}">
            <i class="fa-fw fa-solid fa-user-cog"></i> {{ '@forms.settings.title'|trans }}
        </a>
        {% endif %}
    </article>
    {% endif %}

    {% endif %}

{% endblock %}
