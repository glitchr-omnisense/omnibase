{% extends 'layout1.html.twig' %}

{% block title %}{{ user }}{% endblock %}
{% block content %}

    {% if user is defined %}
    <article class="wrapper extended">
        <div class="header">

            <ul class="field-avatar">
                <li class="keep-opacity">{{ user.getFormattedAvatar()|raw }}</li>
            </ul>

            <div class="text d-flex flex-column">

                <h1>
                    Membre #{{ user.id }}: {{ user }}
                    {% if user.isOnline() %}
                        <span class="badge bg-success" title="{{'@messages.profile.online'|trans}}">{{'@messages.profile.online'|trans}}</span>
                    {% elseif user.isActive() %}
                        <span class="badge bg-warning" title="{{'@messages.profile.recentlyActive'|trans}}">{{'@messages.profile.recentlyActive'|trans}}</span>
                    {% endif %}
                </h1>

                <div class="roles mb-1">
                    {% for role in user.roles %}
                        <span class="badge bg-secondary">{{ ('@enum.userRole.' ~ role)|trans }}</span>
                    {% endfor %}
                </div>

                <div class="info">
                    {{ '@messages.profile.registered'|trans([
                        user.createdAt()|datetime("dd MMMM YYYY"),
                        user.createdAt()|datetime("HH:mm")
                    ])|raw }}&nbsp

                    - {% if app.user == user or is_granted("ROLE_ADMIN") %}
                        <a href="{{ path('user_profileEdit', {'id':user.id}) }}">Editer le profil</a>
                    {% endif %}
                    - {% if app.user == user %}
                        <a href="{{ path('security_logout') }}">Se déconnecter</a>
                    {% endif %}
                </div>

                <div class="stats">
                    {{ '@messages.profile.last_seen'|trans([
                        user.updatedAt()|datetime("dd MMMM YYYY"),
                        user.updatedAt()|datetime("HH:mm")
                    ])|raw }}&nbsp
                </div>

                <div class="activity d-flex mt-2">
                    <div class="me-4">
                        <strong>{{ user.threads|length }}</strong> {{'@messages.profile.threads'|trans}}
                    </div>
                    <div class="me-4">
                        <strong>{{ user.likes|length }}</strong> {{'@messages.profile.likes'|trans}}
                    </div>
                </div>
            </div>
        </div>

    </article>
    {% endif %}

{% endblock %}
