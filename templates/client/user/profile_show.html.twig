{% extends 'layout1.html.twig' %}
{# A member's profile (Base\Screen\Account\ProfilePage, `screen`); a host page rendering it with the user alone gets the same model from account_profile(user). #}
{% set screen = screen ?? account_profile(user) %}
{% block title %}{{ screen.member.name }}{% endblock %}
{% block content %}

    {% if screen.member is defined %}

    {# Only the account holder - or an administrator - sees anything beyond
       the public header. Everything below this flag is about the account,
       not about the person's public presence on the site. #}
    {% set isOwnProfile = screen.own %}
    {% set canSeeAccount = screen.account is not null %}

    <article class="wrapper extended">
        <div class="header">

            <ul class="field-avatar">
                <li class="keep-opacity">{% if screen.member.avatarHtml is not null %}{{ screen.member.avatarHtml|raw }}{% elseif screen.member.avatar is not null %}<img class="avatar" alt="{{ screen.member.name }}" src="{{ screen.member.avatar }}" width="128" height="128">{% else %}<span class="avatar avatar-placeholder" title="{{ screen.member.name }}"><i class="fa-solid fa-user"></i></span>{% endif %}</li>
            </ul>

            <div class="text d-flex flex-column">

                <h1>
                    {{ '@messages.profile.member'|trans }} #{{ screen.member.id }}: {{ screen.member.name }}
                    {% if screen.member.online %}
                        <span class="badge bg-success" title="{{'@messages.profile.online'|trans}}">{{'@messages.profile.online'|trans}}</span>
                    {% elseif screen.member.active %}
                        <span class="badge bg-warning" title="{{'@messages.profile.recentlyActive'|trans}}">{{'@messages.profile.recentlyActive'|trans}}</span>
                    {% endif %}
                </h1>

                <div class="roles mb-1">
                    {# Domain is "enums" (plural) and the catalogue is snake_case
                       with a _singular/_plural suffix - see TranslationEnumsCommand,
                       which generates exactly this shape. The previous
                       '@enum.userRole.' ~ role built none of that, so every badge
                       rendered its raw key (e.g. "@enum.userRole.ROLE_EDITOR"). #}
                    {% for role in screen.member.roles %}
                        <span class="badge bg-secondary">{{ ('@enums.user_role.' ~ role|lower ~ '._singular')|trans }}</span>
                    {% endfor %}
                </div>

                <div class="info">
                    {{ '@messages.profile.registered'|trans([
                        screen.member.registeredAt|datetime("dd MMMM YYYY"),
                        screen.member.registeredAt|datetime("HH:mm")
                    ])|raw }}&nbsp

                    {% if screen.editUrl %}
                        - <a href="{{ screen.editUrl }}">{{ '@messages.profile.edit'|trans }}</a>
                    {% endif %}
                    {% if isOwnProfile %}
                        - <a href="{{ screen.settingsUrl }}">{{ '@forms.settings.title'|trans }}</a>
                        - <a href="{{ screen.logoutUrl }}" rel="nofollow">{{ '@messages.profile.logout'|trans }}</a>
                    {% endif %}
                </div>

                <div class="stats">
                    {{ '@messages.profile.last_seen'|trans([
                        screen.member.lastSeenAt|datetime("dd MMMM YYYY"),
                        screen.member.lastSeenAt|datetime("HH:mm")
                    ])|raw }}&nbsp
                </div>

                <div class="activity d-flex mt-2">
                    <div class="me-4">
                        <strong>{{ screen.member.threads }}</strong> {{'@messages.profile.threads'|trans}}
                    </div>
                    <div class="me-4">
                        <strong>{{ screen.member.likes }}</strong> {{'@messages.profile.likes'|trans}}
                    </div>
                </div>
            </div>
        </div>

    </article>

    {# Most recent published writing: the five latest published threads with
       a title, newest first, picked by the screen's builder (Accounts::recent()) -
       an author with hundreds of articles should not turn their profile into
       an archive page. #}
    {% set published = screen.recent %}
    {% if published|length %}
    <article class="wrapper extended">
        <h3>{{ '@messages.profile.recentThreads'|trans }}</h3>
        <ul class="list-group">
            {% for thread in published %}
                <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <a href="{{ thread.url }}">{{ thread.title }}</a>
                    <small class="text-muted">{{ thread.publishedAt|datetime("dd MMMM YYYY") }}</small>
                </li>
            {% endfor %}
        </ul>
    </article>
    {% endif %}

    {% if canSeeAccount %}
    <article class="wrapper extended">
        <h3>{{ '@messages.profile.accountSecurity'|trans }}</h3>
        <ul class="list-group">
            {% if screen.account.twoFactor is not null %}
            <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                {{ '@forms.settings.twoFactor'|trans }}
                {% if screen.account.twoFactor %}
                    <span class="badge bg-success">{{ '@forms.settings.enabled'|trans }}</span>
                {% else %}
                    <span class="badge bg-secondary">{{ '@messages.profile.notEnabled'|trans }}</span>
                {% endif %}
            </li>
            {% endif %}
            {% if screen.account.passkeys is not null %}
            <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                {{ '@forms.settings.passkeys'|trans }}
                <span class="badge {{ screen.account.passkeys ? 'bg-success' : 'bg-secondary' }}">{{ screen.account.passkeys }}</span>
            </li>
            {% endif %}
            <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span><i class="fa-fw fa-brands fa-google"></i> Google</span>
                {% if screen.account.identityProvider == 'google' %}
                    <span class="badge bg-success">{{ '@forms.settings.connected'|trans }}</span>
                {% else %}
                    <span class="badge bg-secondary">{{ '@messages.profile.notConnected'|trans }}</span>
                {% endif %}
            </li>
            <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                {{ '@forms.settings.preferences'|trans }}
                <small class="text-muted">{{ screen.account.locale }} &middot; {{ screen.account.timezone }}</small>
            </li>
        </ul>
        {% if isOwnProfile %}
        <a class="btn btn-sm btn-primary mt-2" href="{{ screen.settingsUrl }}">
            <i class="fa-fw fa-solid fa-user-cog"></i> {{ '@forms.settings.title'|trans }}
        </a>
        {% endif %}
    </article>
    {% endif %}

    {% endif %}

{% endblock %}
