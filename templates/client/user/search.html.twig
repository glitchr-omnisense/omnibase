{% extends 'layout1.html.twig' %}

{# The members' search (user_search): the controller gives `users`, the members whose username
   holds the term, and `form_data`, the search (its `username`). #}
{% block title %}{{ '@controllers.user_search.title'|trans }}{% endblock %}
{% block content %}
    <article class="wrapper">

        {{ form_start(form, {'attr': {'class': "form-inline"}}) }}

            <div class="d-flex justify-content-center flex-row flex-wrap">
                <h1 class="me-3">{{ '@controllers.user_search.title'|trans }}</h1>
                <div class="input-group w-auto me-3">
                    <div class="form-outline">
                        {{ form_widget(form.username, {'attr': {'placeholder': '@controllers.user_search.searchbar'|trans}}) }}
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-search"></i>
                    </button>
                </div>
            </div>

        {{ form_end(form) }}

    </article>

    {% if form_data.username is not empty %}
        {% if users|length < 1 %}
        <article class="wrapper">
            <div class="header">{{ '@controllers.user_search.no_users'|trans }}</div>
        </article>
        {% else %}
        <article class="wrapper">
            <ul class="user-search-results">
                {% for user in users %}
                <li>
                    <a href="{{ path('user_profile', {id: user.id}) }}">
                        {% include '@Base/client/user/_avatar.html.twig' with {user: user, size: 64} only %}
                        <span class="username">{{ user.username }}</span>
                    </a>
                </li>
                {% endfor %}
            </ul>
        </article>
        {% endif %}
    {% endif %}

{% endblock %}
