{% extends 'layout1.html.twig' %}

{% block title %}{{'@forms.2fa.title'|trans}}{% endblock %}
{% block content %}

<article class="wrapper login half">
<div class="card">
    <div class="card-header">
        <h3 class="text-center">{{'@forms.2fa.title'|trans}}</h3>
    </div>
    <div class="card-body">

        <p>
            {{'@forms.2fa.instructions'|trans}}
        </p>

        {{ form_start(form) }}
        <div class="row">
            <div class="col-sm d-flex align-items-center justify-content-center">
                <img src="{{ path('user_settings_2fa_qrcode') }}" width="200" height="200" alt="TOTP QR code">
            </div>
            <div class="col-sm">
                <div class="input-group form-group mb-2">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fa-fw fa-solid fa-hashtag"></i></span>
                    </div>
                    {{ form_widget(form.code) }}
                </div>
                <div class="invalid-feedback d-block">{{ form_errors(form.code) }}</div>
                {{ form_rest(form) }}

                <button class="w-100 btn btn-lg btn-primary mt-2" type="submit">{{'@forms.2fa.enable'|trans}}</button>
            </div>
        </div>
        {{ form_end(form) }}
    </div>

    <div class="card-footer">
        <div class="text-center">
            <a href="{{ path('user_settings') }}">{{'@forms.back'|trans}}</a>
        </div>
    </div>
</div>
</article>

{% endblock %}
