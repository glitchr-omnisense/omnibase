{% extends 'layout1.html.twig' %}

{% block title %}{{ '@forms.2fa.challengeTitle'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('form.code') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('form.code') }}
{% endblock %}

{% block content %}
<article class="wrapper login half">
<div class="card">
    <div class="card-header">
        <h3 class="text-center">{{'@forms.2fa.challengeTitle'|trans}}</h3>
    </div>
    <div class="card-body">

        {% if authenticationError %}
            <div class="alert alert-danger">{{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}</div>
        {% endif %}

        {% if availableTwoFactorProviders|length > 1 %}
            <p class="text-center mb-3">
                {{ "choose_provider"|trans({}, 'SchebTwoFactorBundle') }}:
                {% for provider in availableTwoFactorProviders %}
                    <a href="{{ path("2fa_login", {"preferProvider": provider}) }}">{{ provider }}</a>
                {% endfor %}
            </p>
        {% endif %}

        <form class="form" action="{{ checkPathUrl ? checkPathUrl: path(checkPathRoute) }}" method="post">
            {#- One box per digit (form/_code_boxes.html.twig, entry form.code):
                the boxes fill the hidden _auth_code and submit once complete.
                Backup codes may be longer: "type it as one field" swaps the
                boxes for a plain input on the same name. -#}
            <p class="text-center text-muted mb-2">{{ 'auth_code'|trans({}, 'SchebTwoFactorBundle') }} ({{ twoFactorProvider }})</p>
            <div class="code-input mb-3{{ authenticationError ? ' is-error' }}" data-code-field data-code-length="6" data-code-alphabet="digits" data-code-uppercase="0" data-code-submit="1">
                {{- include('@Base/form/_code_boxes.html.twig', { length: 6, alphabet: 'digits', autofocus: true }) -}}
                <input type="hidden" id="_auth_code" name="{{ authCodeParameterName }}" value="" autocomplete="one-time-code">
                <a href="#" class="code-manual" data-code-manual>{{ '@forms.2fa.typeAsOneField'|trans }}</a>
            </div>

            {% if displayTrustedOption %}
                <div class="col d-flex justify-content-center">
                    <div class="form-group form-check form-switch form-switch-lg">
                        <input id="_trusted" class="form-check-input" type="checkbox" name="{{ trustedParameterName }}" />
                        <label class="form-check-label" for="_trusted">{{'@forms.2fa.trustDevice'|trans}}</label>
                    </div>
                </div>
            {% endif %}

            {% if isCsrfProtectionEnabled %}
                <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
            {% endif %}

            <hr>

            <div class="login-btn col d-flex flex-column align-items-center">
                <a class="btn btn m-1" href="{{ logoutPath }}">{{'@forms.cancel'|trans}}</a>
                <button class="btn btn-primary m-1" type="submit">{{'@forms.2fa.confirm'|trans}}</button>
            </div>
        </form>

    </div>
</div>
</article>
{% endblock %}
