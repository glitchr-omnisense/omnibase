<div class="theme-filter-dropdown dropdown">
    <button class="btn dropdown-toggle" type="button" id="dropdown-theme-filter" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="fa-solid fa-globe"></i>
    </button>
    <ul class="dropdown-menu {{ class|default("") }}" aria-labelledby="dropdown-theme-filter">
    <li class="dropdown-label">
        <span>{{ '@themizer.filters._plural'|trans }}</span>
    </li>
    {# {% for filter in available_filters %}
        {% set current = (filter == current_filter) ? "active" : null %}
        <li><a href="{{ path("_switch_filter", {_filter: filter|lang}) }}" {{ html_attributes({"class": "dropdown-item "~current}) }}>
            <img class="country-flag" alt="{{filter|country}}" src="{{asset('bundles/base/images/flags/'~(filter|country)~'.svg')}}" style="max-width:50px"> {{ filter|lang_name|capitalize }}
        </a></li>
    {% endfor %} #}
    </ul>
</div>

